# Quick external demo mode
# true: the app works without the FastAPI backend and returns sample SOAP/structured output.
# false: the app calls VITE_API_BASE_URL/api/intake.
VITE_DEMO_MODE=true

# Backend URL for connected mode
VITE_API_BASE_URL=http://localhost:8000

# Must match APP_API_KEY on the backend when VITE_DEMO_MODE=false.
# Vite variables are visible in the browser bundle, so use this only as a lightweight demo gate.
VITE_APP_API_KEY=change-me-for-demo
